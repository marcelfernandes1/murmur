<Window x:Class="Murmur.Windows.Views.RecordingOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murmur dictation" Width="440" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
  <Border Background="#F2191F26" BorderBrush="#485869" BorderThickness="1" CornerRadius="20" Padding="20,14">
    <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" Height="28" />
        <TextBlock x:Name="ElapsedText" Grid.Column="1" Foreground="#B8C7D5" FontSize="12" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="MessageText" Text="Listening…" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" />
      <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
        <Button Content="Done" Click="Done_Click" Focusable="False" Padding="14,4" MinHeight="30" /><Button Content="Cancel" Click="Cancel_Click" Focusable="False" Padding="14,4" MinHeight="30" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
